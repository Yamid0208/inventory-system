# ==============================================================================
# SISTEMA DE GESTIÓN DE INVENTARIO - VARIABLES DE ENTORNO PARA PRODUCCIÓN (VPS)
# ==============================================================================
# Copie este archivo como '.env.production' en su VPS y asigne valores seguros.
# NUNCA suba el archivo '.env.production' final a Git o repositorios públicos.

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL 16 en VPS - Ligera y de Alto Rendimiento: ~50MB RAM)
# ------------------------------------------------------------------------------
POSTGRES_DB=InventoryDb
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=CAMBIE_ESTA_CONTRASENA_POR_UNA_ROBUSTA_2026!
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=InventoryDb;Username=inventory_user;Password=CAMBIE_ESTA_CONTRASENA_POR_UNA_ROBUSTA_2026!;TrustServerCertificate=True;

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación JWT
# ------------------------------------------------------------------------------
# Genere una clave aleatoria de al menos 64 caracteres.
# En Linux puede generarla con: openssl rand -base64 48
Jwt__Key=CAMBIE_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_MINIMO_64_CARACTERES_EN_PRODUCCION_2026
Jwt__Issuer=InventoryManagementAPI
Jwt__Audience=InventoryManagementApp
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# ------------------------------------------------------------------------------
# 3. Inteligencia Artificial (Google Gemini)
# ------------------------------------------------------------------------------
Gemini__ApiKey=SU_CLAVE_API_DE_GOOGLE_GEMINI_AQUI
Gemini__Model=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 4. Dominio y CORS
# ------------------------------------------------------------------------------
# URL o dominio de su VPS (ejemplo: https://inventario.miempresa.com o http://IP_PUBLICA:8080)
Cors__AllowedOrigins=https://su-dominio.com

# ------------------------------------------------------------------------------
# 5. SuperAdmin Inicial (Se crea automáticamente en el primer arranque)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=superadmin@suempresa.com
INITIAL_ADMIN_PASSWORD=ContraseñaSuperSegura2026*!

# ------------------------------------------------------------------------------
# 6. Puerto en el Host VPS
# ------------------------------------------------------------------------------
# Puerto local donde escuchará el frontend (por defecto 8080 para estar detrás de Nginx)
APP_PORT=8080
