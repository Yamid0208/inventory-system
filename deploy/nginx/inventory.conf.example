# ==============================================================================
# CONFIGURACIÓN DE NGINX PARA SISTEMA DE GESTIÓN DE INVENTARIO (HOSTINGER VPS)
# ==============================================================================
# Copie este archivo en: /etc/nginx/sites-available/inventario.conf
# Luego active el sitio con: sudo ln -s /etc/nginx/sites-available/inventario.conf /etc/nginx/sites-enabled/
# Y obtenga SSL con: sudo certbot --nginx -d su-dominio.com

server {
    listen 80;
    server_name su-dominio.com www.su-dominio.com;

    # Redirección automática a HTTPS
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name su-dominio.com www.su-dominio.com;

    # Certificados SSL (Generados automáticamente por Certbot)
    ssl_certificate /etc/letsencrypt/live/su-dominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/su-dominio.com/privkey.pem;

    # Parámetros SSL recomendados por Mozilla
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Límite de tamaño para subida masiva de Excel e imágenes (15 MB)
    client_max_body_size 15M;

    # Cabeceras de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Proxy hacia el contenedor Docker de la aplicación
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Headers obligatorios para que ASP.NET Core identifique HTTPS y la IP real del cliente
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
